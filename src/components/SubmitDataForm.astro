---
import { SITE } from "../config/site.mjs";

const web3formsAccessKey = SITE.web3formsAccessKey || "";
const currentYear = new Date().getFullYear();
---

<form
  id="submit-form"
  class="space-y-6"
  aria-label="Formulir kontribusi data SNBP"
  novalidate
  action="https://api.web3forms.com/submit"
  method="POST"
>
  {
    web3formsAccessKey && (
      <input type="hidden" name="access_key" value={web3formsAccessKey} />
    )
  }
  <input type="hidden" name="subject" value="Kiriman data SNBP baru" />
  <input type="hidden" name="redirect" value="false" />
  <!-- Honeypot spam protection -->
  <input
    type="checkbox"
    name="botcheck"
    class="hidden"
    style="display: none;"
    tabindex="-1"
    autocomplete="off"
  />

  <div
    id="success-message"
    class="hidden p-4 bg-green-50 border border-green-200 rounded-lg text-green-800"
    role="alert"
    aria-live="polite"
  >
    <p class="font-medium">Terima kasih! Data sudah kami terima.</p>
    <p class="text-sm mt-1">
      Kami akan tinjau dan tambahkan ke situs dalam beberapa hari.
    </p>
  </div>

  <div
    id="error-message"
    class="hidden p-4 bg-red-50 border border-red-200 rounded-lg text-red-800"
    role="alert"
    aria-live="assertive"
  >
    <p class="font-medium" id="error-text"></p>
  </div>

  <div class="grid sm:grid-cols-2 gap-6">
    <div>
      <label for="school" class="block text-sm font-medium text-gray-700 mb-2">
        Nama sekolah <span class="text-red-600" aria-label="wajib diisi">*</span
        >
      </label>
      <input
        type="text"
        id="school"
        name="school"
        required
        aria-required="true"
        placeholder="mis. SMAN 3 Bandung"
        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-gray-900 outline-none transition-colors"
      />
    </div>
    <div>
      <label for="year" class="block text-sm font-medium text-gray-700 mb-2">
        Tahun kelulusan <span class="text-red-600" aria-label="wajib diisi"
          >*</span
        >
      </label>
      <select
        id="year"
        name="year"
        required
        aria-required="true"
        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-gray-900 outline-none transition-colors bg-white"
      >
        <option value="">Pilih tahun</option>
        {
          [currentYear + 1, currentYear, currentYear - 1, currentYear - 2].map(
            (y) => <option value={y}>{y}</option>,
          )
        }
      </select>
    </div>
  </div>

  <div>
    <label for="accepted" class="block text-sm font-medium text-gray-700 mb-2">
      Total siswa lolos SNBP <span class="text-red-600" aria-label="wajib diisi"
        >*</span
      >
    </label>
    <input
      type="number"
      id="accepted"
      name="accepted"
      min="0"
      required
      aria-required="true"
      placeholder="mis. 55"
      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-gray-900 outline-none transition-colors"
    />
  </div>

  <div>
    <label for="breakdown" class="block text-sm font-medium text-gray-700 mb-2">
      Rincian per universitas <span class="text-gray-400 font-normal"
        ></span
      >
    </label>
    <textarea
      id="breakdown"
      name="breakdown"
      rows="4"
      placeholder={"mis.\nITB: 20\nUnpad: 15\nUPI: 5"}
      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-gray-900 outline-none transition-colors resize-none font-mono text-sm"
    ></textarea>
  </div>

  <div>
    <label for="source" class="block text-sm font-medium text-gray-700 mb-2">
      Link sumber <span class="text-red-600" aria-label="wajib diisi">*</span>
    </label>
    <input
      type="url"
      id="source"
      name="source"
      required
      aria-required="true"
      placeholder="Link post Instagram, artikel, atau pengumuman resmi sekolah"
      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-gray-900 outline-none transition-colors"
    />
    <p class="mt-1 text-xs text-gray-400">
      Ini yang paling penting. Tanpa sumber, data tidak bisa kami verifikasi.
    </p>
  </div>

  <div class="grid sm:grid-cols-2 gap-6">
    <div>
      <label
        for="from_name"
        class="block text-sm font-medium text-gray-700 mb-2"
        >Nama kamu <span class="text-gray-400 font-normal">(opsional, untuk follow-up)</span
        ></label
      >
      <input
        type="text"
        id="from_name"
        name="from_name"
        autocomplete="name"
        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-gray-900 outline-none transition-colors"
      />
    </div>
    <div>
      <label
        for="from_email"
        class="block text-sm font-medium text-gray-700 mb-2"
        >Email kamu <span class="text-gray-400 font-normal"
          >(opsional, untuk follow-up)</span
        ></label
      >
      <input
        type="email"
        id="from_email"
        name="from_email"
        autocomplete="email"
        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-gray-900 outline-none transition-colors"
      />
    </div>
  </div>

  <button
    type="submit"
    id="submit-button"
    class="w-full px-6 py-3 bg-gray-900 text-white rounded-lg hover:bg-amber-700 transition-colors font-medium focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-50 disabled:cursor-not-allowed"
  >
    <span id="submit-text">Kontribusi data</span>
    <span id="submit-loading" class="hidden">Mengirim…</span>
  </button>
</form>

<script>
  const form = document.getElementById("submit-form");
  const submitButton = document.getElementById("submit-button");
  const submitText = document.getElementById("submit-text");
  const submitLoading = document.getElementById("submit-loading");
  const successMessage = document.getElementById("success-message");
  const errorMessage = document.getElementById("error-message");
  const errorText = document.getElementById("error-text");

  const accessKeyInput = form.querySelector('input[name="access_key"]');
  const hasAccessKey = !!accessKeyInput && accessKeyInput.value.trim() !== "";

  if (!hasAccessKey) {
    const warningDiv = document.createElement("div");
    warningDiv.className =
      "p-4 bg-yellow-50 border border-yellow-200 rounded-lg text-yellow-800 text-sm mb-2";
    warningDiv.innerHTML = `
      <p class="font-medium mb-1">⚠️ Formulir belum aktif</p>
      <p>Tambahkan Web3Forms access key di <code class="bg-yellow-100 px-1 rounded">src/config/site.mjs</code>. Ambil key gratis di <a href="https://web3forms.com" target="_blank" rel="noopener noreferrer" class="underline">web3forms.com</a></p>
    `;
    form.insertBefore(warningDiv, form.firstChild);
  }

  function setLoading(loading) {
    submitButton.disabled = loading;
    submitText.classList.toggle("hidden", loading);
    submitLoading.classList.toggle("hidden", !loading);
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    successMessage.classList.add("hidden");
    errorMessage.classList.add("hidden");

    if (!hasAccessKey) {
      errorText.textContent =
        "Formulir belum dikonfigurasi. Hubungi pengelola situs.";
      errorMessage.classList.remove("hidden");
      return;
    }

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    setLoading(true);
    try {
      const formData = new FormData(form);
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        body: formData,
      });
      const data = await response.json();

      if (response.ok && data.success) {
        successMessage.classList.remove("hidden");
        form.reset();
        successMessage.scrollIntoView({ behavior: "smooth", block: "nearest" });
      } else {
        errorText.textContent =
          data.message || "Gagal mengirim data. Coba lagi.";
        errorMessage.classList.remove("hidden");
      }
    } catch {
      errorText.textContent =
        "Gagal terhubung. Periksa koneksi internet kamu dan coba lagi.";
      errorMessage.classList.remove("hidden");
    } finally {
      setLoading(false);
    }
  });
</script>
