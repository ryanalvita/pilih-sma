---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "../config/site.mjs";
---

<Layout
  title="Dukungan"
  description="Dukung pengembangan PilihSMA supaya bisa terus gratis dan berkembang."
  canonicalURL={`${SITE.pathPrefix}/support`}
>
  <Header />
  <main id="main-content" role="main" class="max-w-2xl mx-auto px-4 py-10">
    <a href={`${SITE.pathPrefix}/`} class="text-sm text-gray-500 hover:text-amber-700"
      >← Beranda</a
    >

    <header class="mt-4 mb-8">
      <p
        class="font-mono text-xs uppercase tracking-widest text-amber-700 mb-2"
      >
        Dukungan
      </p>
      <h1 class="text-3xl font-bold text-gray-900 tracking-tight">
        Dukung PilihSMA
      </h1>
    </header>

    <p class="text-gray-600 leading-relaxed">
      Situs ini saya kelola sendiri di waktu luang, gratis dan tanpa iklan,
      supaya bisa terus bermanfaat untuk siswa dan orang tua yang sedang
      memilih SMA.
    </p>
    <p class="mt-4 text-gray-600 leading-relaxed">
      Kalau situs ini membantu kamu atau keluargamu, boleh traktir kopi
      supaya proyek ini bisa terus berjalan. 🌱
    </p>

    <div class="mt-8">
      <a
        href="https://buymeacoffee.com/ryanalvita"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg bg-amber-400 px-4 py-2 text-gray-900 font-semibold hover:bg-amber-500 transition-colors"
      >
        <Icon name="tabler:coffee" class="h-5 w-5" aria-hidden="true" />
        Traktir kopi
      </a>
    </div>
  </main>
  <Footer />
</Layout>
