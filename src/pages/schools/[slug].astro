---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Sparkline from "../../components/Sparkline.astro";
import {
  ALL_SCHOOLS,
  recordsForSchool,
  topUniversities,
  universityInfo,
  universityLabel,
  YEARS,
} from "../../data";

export function getStaticPaths() {
  return ALL_SCHOOLS.map((s) => ({
    params: { slug: s.slug },
    props: { school: s },
  }));
}

const { school } = Astro.props;
const records = recordsForSchool(school.slug).sort((a, b) => a.year - b.year);

// Universities this school has ever sent students to, ranked by total
// accepted across all recorded years (most-sent-to first) — same ranking
// logic as the "top universities" list this replaces.
const universityRows = topUniversities(records, Infinity).map(([name]) => name);

/** accepted count for one university in one year -> null when that year's breakdown is unknown (not zero) */
function valueFor(uni: string, year: number): number | null {
  const rec = records.find((r) => r.year === year);
  if (!rec || !rec.hasBreakdown) return null;
  return rec.universities[uni] ?? 0;
}

/** link text for a source URL: "Instagram" for IG posts, else the bare domain */
function sourceLabel(source: string): string {
  return source.includes("instagram.com")
    ? "Instagram"
    : source.replace(/^https?:\/\//, "");
}

const yearsMissingBreakdown = records.filter((r) => !r.hasBreakdown);
---

<Layout
  title={`${school.name} — hasil SNBP`}
  description={`Rincian hasil SNBP ${school.name} tahun 2024–2026, per universitas.`}
  canonicalURL={`/schools/${school.slug}/`}
>
  <Header />
  <main id="main-content" role="main" class="max-w-5xl mx-auto px-4 py-10">
    <a href="/" class="text-sm text-gray-500 hover:text-amber-700"
      >← Beranda</a
    >

    <header class="mt-4 mb-4">
      <p
        class="font-mono text-xs uppercase tracking-widest text-amber-700 mb-2"
      >
        {school.type === "negeri" ? "SMA Negeri" : "SMA Swasta"} · Kota Bandung
      </p>
      <h1 class="text-3xl font-bold text-gray-900 tracking-tight">
        {school.name}
      </h1>
    </header>

    {
      universityRows.length > 0 && (
        <section class="mb-10 overflow-x-auto">
          <p class="text-sm text-gray-500 mb-4">
            Jumlah siswa diterima SNBP tiap tahun, dirincikan per universitas, diurutkan dari tujuan terbanyak
          </p>
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="border-b-2 border-gray-900">
                <th
                  scope="col"
                  class="text-left font-mono text-xs uppercase tracking-wider text-gray-500 py-2 pr-3"
                >
                  Universitas
                </th>
                {YEARS.map((y) => (
                  <th
                    scope="col"
                    class="text-center font-mono text-xs uppercase tracking-wider text-gray-500 py-2 px-2 w-16"
                  >
                    {y}
                  </th>
                ))}
                <th
                  scope="col"
                  class="text-left font-mono text-xs uppercase tracking-wider text-gray-500 py-2 pl-3 w-56"
                >
                  Tren
                </th>
              </tr>
            </thead>
            <tbody>
              {universityRows.map((uni) => (
                <tr class="border-b border-gray-100 hover:bg-gray-50">
                  <th
                    scope="row"
                    class="text-left font-semibold text-gray-900 py-3 pr-3"
                  >
                    {universityLabel(uni)}
                  </th>
                  {YEARS.map((y) => {
                    const val = valueFor(uni, y);
                    return (
                      <td class="text-center py-3 px-2 tabular-nums">
                        {val ?? <span class="text-gray-300">–</span>}
                      </td>
                    );
                  })}
                  <td class="py-3 pl-3">
                    <Sparkline
                      values={YEARS.map((y) => valueFor(uni, y))}
                      label={`Tren ${universityInfo(uni)?.abbreviation ?? uni} di ${school.name}: ${YEARS.map((y) => `${y} ${valueFor(uni, y) ?? "tidak ada data"}`).join(", ")}`}
                    />
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          {yearsMissingBreakdown.length > 0 && (
            <p class="text-xs text-gray-400 mt-3">
              "–" bukan berarti nol —{" "}
              {yearsMissingBreakdown
                .map((r) => `${r.year} (total ${r.accepted ?? "–"} lolos)`)
                .join(", ")}{" "}
              belum ada rincian per universitas, hanya total yang tercatat.
            </p>
          )}
        </section>
      )
    }

    {
      records.length > 0 && (
        <section class="mb-10 overflow-x-auto">
          <h2 class="text-base font-semibold text-gray-900 mb-4">
            Ringkasan per tahun
          </h2>
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="border-b-2 border-gray-900">
                <th
                  scope="col"
                  class="text-left font-mono text-xs uppercase tracking-wider text-gray-500 py-2 pr-3"
                >
                  Tahun
                </th>
                <th
                  scope="col"
                  class="text-right font-mono text-xs uppercase tracking-wider text-gray-500 py-2 px-2"
                >
                  Lolos
                </th>
                <th
                  scope="col"
                  class="text-left font-mono text-xs uppercase tracking-wider text-gray-500 py-2 px-3"
                >
                  Catatan
                </th>
                <th
                  scope="col"
                  class="text-left font-mono text-xs uppercase tracking-wider text-gray-500 py-2 pl-3"
                >
                  Sumber
                </th>
              </tr>
            </thead>
            <tbody>
              {records.map((r) => (
                <tr class="border-b border-gray-100">
                  <td class="py-2 pr-3 font-semibold text-gray-900">
                    {r.year}
                  </td>
                  <td class="py-2 px-2 text-right tabular-nums">
                    {r.accepted ?? "–"}
                  </td>
                  <td class="py-2 px-3 text-gray-500">{r.note ?? ""}</td>
                  <td class="py-2 pl-3">
                    {r.source ? (
                      <a
                        href={
                          r.source.startsWith("http")
                            ? r.source
                            : `https://${r.source}`
                        }
                        target="_blank"
                        rel="noopener"
                        class="text-gray-600 hover:text-amber-700 underline"
                      >
                        {sourceLabel(r.source)}
                      </a>
                    ) : (
                      <span class="text-gray-400">tidak dicatat</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      )
    }

    {
      records.length === 0 && (
        <p class="text-gray-500">Belum ada data untuk sekolah ini.</p>
      )
    }

    <p class="mt-10">
      <a href="/submit" class="text-amber-700 font-medium hover:underline">
        Punya data yang lebih lengkap untuk {school.name}? Kirim ke kami →
      </a>
    </p>
  </main>
  <Footer />
</Layout>
