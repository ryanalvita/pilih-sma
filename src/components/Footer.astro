---
import { SITE } from "../config/site.mjs";
---

<footer
  class="w-full py-10 px-4 border-t border-gray-200 bg-white"
  role="contentinfo"
>
  <div class="max-w-5xl mx-auto text-sm text-gray-500 leading-relaxed">
    <nav aria-label="Footer navigation">
      <ul class="flex flex-wrap gap-x-4 gap-y-1">
        <li>
          <a
            href={`${SITE.base}/feedback`}
            class="hover:text-amber-700 transition-colors">Masukan</a
          >
        </li>
        <li>
          <a
            href={`${SITE.base}/support`}
            class="hover:text-amber-700 transition-colors">Dukungan</a
          >
        </li>
      </ul>
    </nav>
    <p class="mt-3">
      &copy; {new Date().getFullYear()} PilihSMA. Proyek non-komersial, dibuat untuk
      membantu siswa dan orang tua dalam memilih SMA.
    </p>
  </div>
</footer>
